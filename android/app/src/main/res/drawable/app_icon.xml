<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面图标（非自适应，API 25 及以下）—— 与网页版 favicon 同一套视觉（2026-11-28 统一）。

  自适应图标（API 26+）见 mipmap-anydpi-v26/ic_launcher.xml + drawable/app_icon_fg|bg。
  这里只在老设备上兜底，所以直接画「深色底 + 银灰 M + 右上圆点」的完整版，
  不拆前景/背景。

  备份：改动前的星形拓扑版在 temp/icon-backup/。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 深色底板（启动器会按自家形状裁切，这里画满） -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="16" android:startY="12"
                android:endX="96" android:endY="100"
                android:startColor="#22323F"
                android:centerColor="#1B2936"
                android:endColor="#131E28" />
        </aapt:attr>
    </path>

    <group android:scaleX="0.72" android:scaleY="0.72"
        android:pivotX="54" android:pivotY="54">
        <!-- M 字形 -->
        <path android:pathData="M26,80 V34 L54,60 L82,34 V80"
            android:strokeWidth="9.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="26" android:startY="34"
                    android:endX="82" android:endY="80"
                    android:startColor="#E6EEF5"
                    android:centerColor="#B5C5D4"
                    android:endColor="#88A6BB" />
            </aapt:attr>
        </path>
        <!-- 右上角识别圆点 -->
        <path android:pathData="M85,20 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
            android:fillColor="#88A6BB" />
    </group>
</vector>
