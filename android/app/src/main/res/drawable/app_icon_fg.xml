<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面图标前景（自适应图标，API 26+）—— 以网页版 favicon 为基准的 M 字形（2026-11-28 统一）。

  108dp 画布，内容缩到 72% 居中：自适应图标的安全区是中心 66dp 圆，
  超出部分会被 OEM 启动器裁掉。M 字形按 favicon 的
  `M10.5 28V12.5l9.5 9 9.5-9V28`（40 画布）换算到 108 画布后保持同一比例。

  备份：改动前的星形拓扑版在 temp/icon-backup/app_icon_fg-topology.xml。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <group android:scaleX="0.72" android:scaleY="0.72"
        android:pivotX="54" android:pivotY="54">

        <!-- M 字形 -->
        <path android:pathData="M26,80 V34 L54,60 L82,34 V80"
            android:strokeWidth="9.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="26" android:startY="34"
                    android:endX="82" android:endY="80"
                    android:startColor="#E6EEF5"
                    android:centerColor="#B5C5D4"
                    android:endColor="#88A6BB" />
            </aapt:attr>
        </path>

        <!-- 右上角识别圆点（跟随主色） -->
        <path android:pathData="M85,20 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
            android:fillColor="#88A6BB" />
    </group>
</vector>
